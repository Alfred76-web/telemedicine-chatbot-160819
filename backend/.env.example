# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/telemedicine_db

# Authentication (use a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Google Gemini (main model first, backups after, comma-separated)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Africa's Talking SMS (sandbox username is "sandbox")
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key
AT_SENDER_ID=
SMS_ENABLED=true

# ML triage service (ml/app.py)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_ENABLED=true
ML_MIN_CONFIDENCE=0.5
ML_TIMEOUT_MS=4000
# Languages where the ML model may raise the triage level (Kiswahili is advisory only)
ML_ESCALATE_LANGUAGES=en
